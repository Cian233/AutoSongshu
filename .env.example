# =========================
# Core Model Configuration
# =========================
AUTOSONGSHU_MODEL_NAME=kimi-k2.5
OPENAI_MODEL_NAME=
OPENAI_MODEL=

# Prefer AUTOSONGSHU_* aliases; OPENAI_* aliases remain supported.
AUTOSONGSHU_MODEL_API_KEY=
OPENAI_API_KEY=
AUTOSONGSHU_MODEL_BASE_URL=
OPENAI_BASE_URL=

AUTOSONGSHU_MODEL_TEMPERATURE=1.0
AUTOSONGSHU_MODEL_TOP_P=0.95
AUTOSONGSHU_MODEL_STREAM=true
AUTOSONGSHU_MODEL_MAX_TOKENS=
AUTOSONGSHU_MODEL_TIMEOUT=120

# =========================
# Engagement / Scope
# =========================
AUTOSONGSHU_ENGAGEMENT_NAME=web-assessment
AUTOSONGSHU_ENGAGEMENT_AUTHORIZATION=
AUTOSONGSHU_ENGAGEMENT_START_URL=
AUTOSONGSHU_ENGAGEMENT_ALLOWED_HOSTS=
AUTOSONGSHU_ENGAGEMENT_ALLOW_SUBDOMAINS=true
AUTOSONGSHU_ENGAGEMENT_MAX_REQUESTS=200
AUTOSONGSHU_ENGAGEMENT_NOTES=

# Backward-compatible aliases also used by skill scripts.
AUTOSONGSHU_AUTHORIZATION=
AUTOSONGSHU_SCOPE_START_URL=
AUTOSONGSHU_SCOPE_ALLOWED_HOSTS=
AUTOSONGSHU_SCOPE_ALLOW_SUBDOMAINS=

# =========================
# Browser Runtime
# =========================
AUTOSONGSHU_BROWSER_MODE=connect_over_cdp
AUTOSONGSHU_BROWSER_CDP_URL=http://127.0.0.1:9222
AUTOSONGSHU_BROWSER_FALLBACK_TO_LAUNCH_ON_CDP_ERROR=true
AUTOSONGSHU_BROWSER_CHANNEL=
AUTOSONGSHU_BROWSER_EXECUTABLE_PATH=
AUTOSONGSHU_BROWSER_HEADLESS=false
AUTOSONGSHU_BROWSER_IGNORE_HTTPS_ERRORS=true
AUTOSONGSHU_BROWSER_TIMEOUT_MS=12000
AUTOSONGSHU_BROWSER_VIEWPORT_WIDTH=1440
AUTOSONGSHU_BROWSER_VIEWPORT_HEIGHT=900

# =========================
# Storage / Database
# =========================
AUTOSONGSHU_DATABASE_URL=sqlite:///./data/autosongshu.db
AUTOSONGSHU_CHAT_DATABASE_URL=
AUTOSONGSHU_AUTH_DATABASE_URL=
AUTOSONGSHU_KNOWLEDGE_DATABASE_URL=

# MySQL example:
# AUTOSONGSHU_DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/autosongshu?charset=utf8mb4

# =========================
# Knowledge Base
# =========================
AUTOSONGSHU_KB_EMBEDDING_PROVIDER=online
AUTOSONGSHU_KB_EMBEDDING_ENABLED=true
AUTOSONGSHU_KB_EMBEDDING_MODEL_NAME=tongyi-embedding-vision-flash-2026-03-06
AUTOSONGSHU_KB_EMBEDDING_API_KEY=
AUTOSONGSHU_KB_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/api/v1
AUTOSONGSHU_KB_EMBEDDING_BATCH_SIZE=8
AUTOSONGSHU_KB_EMBEDDING_DIMENSIONS=
AUTOSONGSHU_KB_EMBEDDING_TIMEOUT=15

AUTOSONGSHU_KB_RERANK_PROVIDER=online
AUTOSONGSHU_KB_RERANK_ENABLED=true
AUTOSONGSHU_KB_RERANK_MODEL_NAME=qwen3-vl-rerank
AUTOSONGSHU_KB_RERANK_API_KEY=
AUTOSONGSHU_KB_RERANK_BASE_URL=https://dashscope.aliyuncs.com/api/v1
AUTOSONGSHU_KB_RERANK_TIMEOUT=15
AUTOSONGSHU_KB_RERANK_MAX_INPUT_CHARS=1600

AUTOSONGSHU_KB_CHUNK_MAX_CHARS=680
AUTOSONGSHU_KB_CHUNK_OVERLAP_CHARS=120
AUTOSONGSHU_KB_CHUNK_MIN_CHARS=120

# Optional fallback key for DashScope embedding/rerank:
DASHSCOPE_API_KEY=

# =========================
# Skills / Artifacts
# =========================
AUTOSONGSHU_SKILLS_ENABLED=true
AUTOSONGSHU_SKILLS_DIRECTORIES=./skills

AUTOSONGSHU_ARTIFACT_ROOT_DIR=./artifacts
AUTOSONGSHU_ARTIFACT_PERSIST_NETWORK_LOG=true
AUTOSONGSHU_ARTIFACT_PERSIST_CONSOLE_LOG=true

# Web console defaults:
AUTOSONGSHU_DEFAULT_CONFIG_PATH=./configs/pentest.example.yaml
AUTOSONGSHU_DEFAULT_ARTIFACT_ROOT=./artifacts

# =========================
# Agent / Compaction
# =========================
AUTOSONGSHU_AGENT_MAX_ITERS=12
AUTOSONGSHU_AGENT_MAX_SUBTASKS=8
AUTOSONGSHU_AGENT_PARALLEL_TOOL_CALLS=false
AUTOSONGSHU_AGENT_ENABLE_META_TOOL=false
AUTOSONGSHU_AGENT_LOOP_GUARD_ENABLED=true

AUTOSONGSHU_COMPACTION_AUTO=true
AUTOSONGSHU_COMPACTION_PRUNE=true
AUTOSONGSHU_COMPACTION_TRIGGER_CHARS=18000
AUTOSONGSHU_COMPACTION_RESERVED_CHARS=4000
AUTOSONGSHU_COMPACTION_MIN_TURNS=4
AUTOSONGSHU_COMPACTION_RETAIN_RECENT_TURNS=2

# =========================
# Python Sandbox
# =========================
AUTOSONGSHU_SANDBOX_ENABLED=true
AUTOSONGSHU_SANDBOX_ISOLATION_MODE=user
AUTOSONGSHU_SANDBOX_SHARED_ROOT_DIR=./data/sandboxes
AUTOSONGSHU_SANDBOX_DEFAULT_USER_ID=local-default-user
AUTOSONGSHU_SANDBOX_ROOT_SUBDIR=sandbox
AUTOSONGSHU_SANDBOX_WORKSPACE_SUBDIR=workspace
AUTOSONGSHU_SANDBOX_VENV_SUBDIR=.venv
AUTOSONGSHU_SANDBOX_ALLOW_PACKAGE_INSTALL=true
AUTOSONGSHU_SANDBOX_BOOTSTRAP_TIMEOUT_SEC=120
AUTOSONGSHU_SANDBOX_INSTALL_TIMEOUT_SEC=300
AUTOSONGSHU_SANDBOX_EXECUTION_TIMEOUT_SEC=120
AUTOSONGSHU_SANDBOX_INDEX_URL=
AUTOSONGSHU_SANDBOX_EXTRA_INDEX_URLS=
AUTOSONGSHU_SANDBOX_TRUSTED_HOSTS=pypi.tuna.tsinghua.edu.cn
AUTOSONGSHU_SANDBOX_BOOTSTRAP_PACKAGES=requests,httpx,beautifulsoup4,lxml,pyyaml

# pip/uv compatible aliases:
UV_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
UV_EXTRA_INDEX_URL=
PIP_INDEX_URL=
PIP_EXTRA_INDEX_URL=
PIP_TRUSTED_HOST=
